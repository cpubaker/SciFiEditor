<Window x:Class="SciFiEditor.App.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SciFiEditor.App.Resources"
        xmlns:controls="clr-namespace:SciFiEditor.App.Controls"
        Title="{x:Static res:Strings.StatsWindowTitle}"
        Height="420" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.StatsHeatmapLabel}" FontWeight="Bold" Margin="0,0,0,6" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <controls:CalendarHeatmapControl Data="{Binding HeatmapData}" DailyGoal="{Binding DailyGoal}" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.StatsChartLabel}" FontWeight="Bold" Margin="0,0,0,6" />
        <controls:WordCountBarChartControl Grid.Row="3" Data="{Binding ChartData}" Height="110" Margin="0,0,0,16"
                                            HorizontalAlignment="Left" />

        <TextBlock Grid.Row="4" Text="{Binding Streak, StringFormat={x:Static res:Strings.StatsStreakLabel}}"
                    FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="5" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:Strings.StatsDailyGoalLabel}" Width="160" VerticalAlignment="Center" />
                <TextBox Text="{Binding DailyGoal, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="100" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:Strings.StatsSessionGoalLabel}" Width="160" VerticalAlignment="Center" />
                <TextBox Text="{Binding SessionGoal, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="100" />
            </StackPanel>
            <Button Content="{x:Static res:Strings.StatsSaveGoals}" Command="{Binding SaveGoalsCommand}"
                    HorizontalAlignment="Left" Width="140" />
        </StackPanel>
    </Grid>
</Window>
