<Window x:Class="SciFiEditor.App.Views.InsertLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SciFiEditor.App.Resources"
        Title="{x:Static res:Strings.DialogInsertLinkTitle}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{x:Static res:Strings.DialogLinkText}" Margin="0,0,0,4" />
            <TextBox x:Name="LinkTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{x:Static res:Strings.DialogLinkUrl}" Margin="0,0,0,4" />
            <TextBox x:Name="UrlTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="{x:Static res:Strings.DialogOk}" MinWidth="80"
                    IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Content="{x:Static res:Strings.DialogCancel}" MinWidth="80"
                    Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
