<UserControl x:Class="SciFiEditor.App.Controls.FindReplaceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SciFiEditor.App.Resources"
             Visibility="Collapsed">
    <Border Background="{DynamicResource AppPanelBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1" Padding="6">
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="FindTextBox" Width="160" Margin="0,0,4,0"
                     TextChanged="FindTextBox_TextChanged" KeyDown="FindTextBox_KeyDown" />
            <Button Content="{x:Static res:Strings.FindNext}" Click="FindNextButton_Click" Margin="0,0,4,0" />
            <Button Content="{x:Static res:Strings.FindPrevious}" Click="FindPreviousButton_Click" Margin="0,0,8,0" />
            <TextBox x:Name="ReplaceTextBox" Width="160" Margin="0,0,4,0" />
            <Button Content="{x:Static res:Strings.ReplaceOne}" Click="ReplaceButton_Click" Margin="0,0,4,0" />
            <Button Content="{x:Static res:Strings.ReplaceAll}" Click="ReplaceAllButton_Click" Margin="0,0,8,0" />
            <TextBlock x:Name="MatchCountText" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="40" />
            <Button Content="✕" Click="CloseButton_Click" Width="24" />
        </StackPanel>
    </Border>
</UserControl>
