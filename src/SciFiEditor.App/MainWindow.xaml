<Window x:Class="SciFiEditor.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SciFiEditor.App"
        xmlns:res="clr-namespace:SciFiEditor.App.Resources"
        xmlns:conv="clr-namespace:SciFiEditor.App.Converters"
        xmlns:behaviors="clr-namespace:SciFiEditor.App.Behaviors"
        xmlns:controls="clr-namespace:SciFiEditor.App.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:dd="urn:gong-wpf-dragdrop"
        mc:Ignorable="d"
        Title="SciFiEditor" Height="720" Width="1280"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        Foreground="{DynamicResource AppWindowForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter" />
        <conv:FocusModeGridLengthConverter x:Key="FocusModeGridLengthConverter" />
        <conv:FocusModeMinWidthConverter x:Key="FocusModeMinWidthConverter" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:Strings.MenuFile}">
                <MenuItem Header="{x:Static res:Strings.MenuNewProject}" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuOpenProject}" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="{x:Static res:Strings.MenuRecentProjects}" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuSave}" Command="{Binding SaveCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuEdit}">
                <MenuItem Header="{x:Static res:Strings.MenuUndo}" Command="ApplicationCommands.Undo"
                          CommandTarget="{Binding ElementName=SceneEditor}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{x:Static res:Strings.MenuRedo}" Command="ApplicationCommands.Redo"
                          CommandTarget="{Binding ElementName=SceneEditor}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuCut}" Command="ApplicationCommands.Cut"
                          CommandTarget="{Binding ElementName=SceneEditor}" InputGestureText="Ctrl+X" />
                <MenuItem Header="{x:Static res:Strings.MenuCopy}" Command="ApplicationCommands.Copy"
                          CommandTarget="{Binding ElementName=SceneEditor}" InputGestureText="Ctrl+C" />
                <MenuItem Header="{x:Static res:Strings.MenuPaste}" Command="ApplicationCommands.Paste"
                          CommandTarget="{Binding ElementName=SceneEditor}" InputGestureText="Ctrl+V" />
                <MenuItem Header="{x:Static res:Strings.MenuSelectAll}" Command="ApplicationCommands.SelectAll"
                          CommandTarget="{Binding ElementName=SceneEditor}" InputGestureText="Ctrl+A" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuFind}" Click="FindMenuItem_Click" InputGestureText="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuView}">
                <MenuItem Header="{x:Static res:Strings.MenuFocusMode}" IsCheckable="True"
                          IsChecked="{Binding IsFocusMode, Mode=TwoWay}" />
                <MenuItem Header="{x:Static res:Strings.MenuToggleTheme}" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuProject}">
                <MenuItem Header="{x:Static res:Strings.BinderAddFolder}" Command="{Binding AddFolderCommand}"
                          IsEnabled="{Binding IsProjectOpen}" />
                <MenuItem Header="{x:Static res:Strings.BinderAddChapter}" Command="{Binding AddChapterCommand}"
                          InputGestureText="Ctrl+Shift+N" IsEnabled="{Binding IsProjectOpen}" />
                <MenuItem Header="{x:Static res:Strings.BinderAddScene}" Command="{Binding AddSceneCommand}"
                          InputGestureText="Ctrl+N" IsEnabled="{Binding IsProjectOpen}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MenuStatistics}" Command="{Binding OpenStatsCommand}"
                          IsEnabled="{Binding IsProjectOpen}" />
                <MenuItem Header="{x:Static res:Strings.MenuCompile}" Command="{Binding OpenCompileCommand}"
                          IsEnabled="{Binding IsProjectOpen}" />
                <MenuItem Header="{x:Static res:Strings.MenuEntities}" Command="{Binding OpenEntitiesCommand}"
                          IsEnabled="{Binding IsProjectOpen}" />
                <MenuItem Header="{x:Static res:Strings.MenuSearch}" Command="{Binding OpenSearchCommand}"
                          IsEnabled="{Binding IsProjectOpen}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MenuHelp}" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{x:Static res:Strings.StatusReady}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{x:Static res:Strings.StatusBarSceneWords}">
                            <Binding Path="SceneWordCount" />
                            <Binding Path="SceneCharCount" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectWordCount, StringFormat={x:Static res:Strings.StatusBarProjectWords}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SessionWordDelta, StringFormat={x:Static res:Strings.StatusBarSessionDelta}}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsFocusMode, Converter={StaticResource FocusModeGridLengthConverter}, ConverterParameter=220}"
                                  MinWidth="{Binding IsFocusMode, Converter={StaticResource FocusModeMinWidthConverter}, ConverterParameter=150}" />
                <ColumnDefinition Width="{Binding IsFocusMode, Converter={StaticResource FocusModeGridLengthConverter}, ConverterParameter=5}" />
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="{Binding IsFocusMode, Converter={StaticResource FocusModeGridLengthConverter}, ConverterParameter=5}" />
                <ColumnDefinition Width="{Binding IsFocusMode, Converter={StaticResource FocusModeGridLengthConverter}, ConverterParameter=280}"
                                  MinWidth="{Binding IsFocusMode, Converter={StaticResource FocusModeMinWidthConverter}, ConverterParameter=200}" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsFocusMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TreeView x:Name="BinderTreeView" ItemsSource="{Binding RootNodes}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="BinderTreeView_SelectedItemChanged"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.UseDefaultDragAdorner="True">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.BinderAddFolder}"
                                      Command="{Binding PlacementTarget.DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.BinderAddChapter}"
                                      Command="{Binding PlacementTarget.DataContext.AddChapterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.BinderAddScene}"
                                      Command="{Binding PlacementTarget.DataContext.AddSceneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Resources>
                        <ContextMenu x:Key="BinderNodeContextMenu">
                            <MenuItem Header="{x:Static res:Strings.BinderAddFolder}"
                                      Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.BinderAddChapter}"
                                      Command="{Binding PlacementTarget.Tag.AddChapterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.BinderAddScene}"
                                      Command="{Binding PlacementTarget.Tag.AddSceneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.BinderIncludeInCompile}" IsCheckable="True"
                                      IsChecked="{Binding PlacementTarget.DataContext.IncludeInCompile, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                      Command="{Binding PlacementTarget.Tag.ToggleIncludeInCompileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.BinderRename}"
                                      Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.BinderDuplicate}"
                                      Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static res:Strings.BinderMoveToTrash}"
                                      Command="{Binding PlacementTarget.Tag.MoveToTrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.BinderSnapshots}"
                                      Command="{Binding PlacementTarget.Tag.OpenSnapshotsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="ContextMenu" Value="{StaticResource BinderNodeContextMenu}" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppWindowForegroundBrush}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <Viewbox Width="12" Height="12" Margin="0,0,5,0"
                                             Visibility="{Binding IsTrashNode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Canvas.Left="9" Canvas.Top="2" Width="6" Height="2"
                                                       Fill="{DynamicResource AppWindowForegroundBrush}" />
                                            <Rectangle Canvas.Left="6" Canvas.Top="4.5" Width="12" Height="2"
                                                       Fill="{DynamicResource AppWindowForegroundBrush}" />
                                            <Path Data="M7,7.5 L8,21 L16,21 L17,7.5 Z"
                                                  Stroke="{DynamicResource AppWindowForegroundBrush}"
                                                  StrokeThickness="1.4" />
                                            <Line X1="10" Y1="10" X2="10.5" Y2="18"
                                                  Stroke="{DynamicResource AppWindowForegroundBrush}" StrokeThickness="1.2" />
                                            <Line X1="14" Y1="10" X2="13.5" Y2="18"
                                                  Stroke="{DynamicResource AppWindowForegroundBrush}" StrokeThickness="1.2" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AppWindowForegroundBrush}" />
                                </StackPanel>
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                         IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                         KeyDown="RenameTextBox_KeyDown"
                                         LostFocus="RenameTextBox_LostFocus" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding IsFocusMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

            <TabControl Grid.Column="2">
                <TabItem Header="{x:Static res:Strings.TabText}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:FormattingToolbar x:Name="FormattingToolbarControl" Grid.Row="0"
                                                     IsEnabled="{Binding IsSceneSelected}" />
                        <controls:FindReplaceBar x:Name="FindReplaceBarControl" Grid.Row="1" />
                        <RichTextBox x:Name="SceneEditor" Grid.Row="2"
                                     behaviors:RichTextBoxMarkdownBehavior.BindableMarkdown="{Binding EditorContent, Mode=TwoWay}"
                                     IsEnabled="{Binding IsSceneSelected}"
                                     Background="{DynamicResource AppWindowBackgroundBrush}"
                                     Foreground="{DynamicResource AppWindowForegroundBrush}"
                                     BorderThickness="0"
                                     FontFamily="Segoe UI" FontSize="14"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                </TabItem>
                <TabItem Header="{x:Static res:Strings.TabBoard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CorkboardNodes}" Margin="8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180" Height="140" Margin="6" Padding="8"
                                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                            Background="{DynamicResource AppPanelBackgroundBrush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Ellipse Grid.Column="1" Width="10" Height="10"
                                                         Fill="{Binding Status, Converter={StaticResource NodeStatusToBrushConverter}}" />
                                            </Grid>
                                            <TextBox Grid.Row="1" Text="{Binding Synopsis, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                     Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"
                                                     LostFocus="InspectorField_LostFocus" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{x:Static res:Strings.TabPreview}">
                    <wv2:WebView2 behaviors:WebView2Behavior.BindableHtml="{Binding PreviewHtml}" />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding IsFocusMode, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

            <Border Grid.Column="4" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsFocusMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" DataContext="{Binding SelectedNode}">
                        <TextBlock Text="{x:Static res:Strings.InspectorSynopsis}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Synopsis, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 VerticalScrollBarVisibility="Auto"
                                 LostFocus="InspectorField_LostFocus" />

                        <TextBlock Text="{x:Static res:Strings.InspectorNotes}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                                 VerticalScrollBarVisibility="Auto"
                                 LostFocus="InspectorField_LostFocus" />

                        <TextBlock Text="{x:Static res:Strings.InspectorStatus}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding DataContext.StatusOptions, ElementName=RootWindow}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Status}"
                                  SelectionChanged="InspectorField_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{x:Static res:Strings.InspectorLabel}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="InspectorField_LostFocus" />

                        <TextBlock Text="{x:Static res:Strings.InspectorTargetWordCount}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding TargetWordCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 LostFocus="InspectorField_LostFocus" />

                        <TextBlock Text="{x:Static res:Strings.EntityTabCharacters}" Margin="0,12,0,4" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding DataContext.CharacterLinkOptions, ElementName=RootWindow}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsLinked, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleEntityLinkCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Static res:Strings.EntityTabLocations}" Margin="0,12,0,4" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding DataContext.LocationLinkOptions, ElementName=RootWindow}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsLinked, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleEntityLinkCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
