<Window x:Class="Scriptorium.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scriptorium.App"
        xmlns:res="clr-namespace:Scriptorium.App.Resources"
        mc:Ignorable="d"
        Title="Scriptorium" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:Strings.MenuFile}" />
            <MenuItem Header="{x:Static res:Strings.MenuEdit}" />
            <MenuItem Header="{x:Static res:Strings.MenuView}" />
            <MenuItem Header="{x:Static res:Strings.MenuProject}" />
            <MenuItem Header="{x:Static res:Strings.MenuHelp}" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{x:Static res:Strings.StatusReady}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="280" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="0,0,1,0">
                <!-- Binder: manuscript tree, populated in M1 -->
                <Grid />
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <TabControl Grid.Column="2">
                <TabItem Header="{x:Static res:Strings.TabText}">
                    <!-- AvalonEdit scene editor, wired up in M1 -->
                    <Grid />
                </TabItem>
                <TabItem Header="{x:Static res:Strings.TabBoard}">
                    <!-- Corkboard, wired up in M5 -->
                    <Grid />
                </TabItem>
                <TabItem Header="{x:Static res:Strings.TabPreview}">
                    <!-- WebView2 Markdown preview, wired up in M4 -->
                    <Grid />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="4" BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1,0,0,0">
                <!-- Inspector: synopsis/notes/status/POV, populated in M2 -->
                <Grid />
            </Border>
        </Grid>
    </DockPanel>
</Window>
